{
  "name": "image-resizer",
  "version": "1.0.0",
  "description": "Tiny client-side tool that resizes oversized images and copies them to your clipboard — to stop losing AI chat sessions to the \"image too large\" error.",
  "license": "MIT",
  "keywords": [
    "image-resize",
    "clipboard",
    "claude-code",
    "screenshot",
    "retina",
    "cloudflare-workers",
    "static-site"
  ],
  "scripts": {
    "vendor": "mkdir -p public/vendor && cp node_modules/heic-to/dist/iife/heic-to.js public/vendor/heic-to.js",
    "postinstall": "npm run vendor",
    "dev": "wrangler dev",
    "deploy": "npm run vendor && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "heic-to": "^1.5.2"
  }
}
